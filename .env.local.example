# Supabase — Replace with your project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Replace with your test keys
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fluxitron — Custom Store Connector
FLUXITRON_API_KEY=your_generated_api_key
FLUXITRON_WEBHOOK_URL=https://api.fluxitron.com/webhooks/custom/your_store_id
FLUXITRON_WEBHOOK_API_KEY=flx_whk_your_webhook_key

# Boxtal — Livraison (API V3, affranchissement Chronopost express)
BOXTAL_ACCESS_KEY=your_boxtal_access_key
BOXTAL_SECRET_KEY=your_boxtal_secret_key
# Base API : TEST (sandbox, non facturé) par défaut. PROD = https://api.boxtal.com
# ⚠️ Les clés doivent correspondre à l'environnement (clé TEST ↔ build, clé PROD ↔ com).
BOXTAL_API_BASE=https://api.boxtal.build
# Offre Chronopost express : CHRP-Chrono18 (J+1 avant 18h, défaut) ou CHRP-Chrono13.
BOXTAL_OFFER_CODE=CHRP-Chrono18
# Adresse expéditeur (défaut : siège TEL & CASH Angers) — surchargez si besoin.
# BOXTAL_SENDER_COMPANY=TEL & CASH
# BOXTAL_SENDER_EMAIL=infos@telandcash.fr
# BOXTAL_SENDER_PHONE=0285359532
# BOXTAL_SENDER_NUMBER=10
# BOXTAL_SENDER_STREET=rue Saint-Étienne
# BOXTAL_SENDER_ZIP=49100
# BOXTAL_SENDER_CITY=Angers
# BOXTAL_SENDER_COUNTRY=FR

# ── Envoi d'emails transactionnels (confirmation, suivi, annulation/remboursement) ──
# Deux transports possibles. Si SMTP_HOST est défini, c'est le SMTP qui est utilisé ;
# sinon on retombe sur Resend. Sans aucun des deux : email ignoré (pas de crash).

# Option A — SMTP de la boîte pro du domaine (OVH, IONOS, Gandi…). Recommandé si le
# client a déjà une adresse pro sur son domaine. Port 465 = SSL, 587 = STARTTLS.
# Exemples d'hôtes : OVH = ssl0.ovh.net:465 · IONOS = smtp.ionos.fr:465 · Gandi = mail.gandi.net:465
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_USER=infos@telandcash.fr
# SMTP_PASSWORD=le_mot_de_passe_de_la_boite
# EMAIL_FROM=TEL & CASH <infos@telandcash.fr>   # défaut : RESEND_FROM puis SMTP_USER

# Option B — Resend (API HTTP). Nécessite un domaine vérifié dans Resend pour la prod.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=TEL & CASH <infos@telandcash.fr>

# Adresse boutique qui reçoit la notification « nouvelle commande » à chaque
# paiement. Défaut : adresse extraite de RESEND_FROM, sinon infos@telandcash.fr.
MERCHANT_EMAIL=infos@telandcash.fr

# Umami Cloud API — lecture des stats de trafic dans /admin/stats (section Umami).
# Clé API (commence par api_…) générée dans Umami Cloud → Settings → API.
# Serveur uniquement : ne jamais exposer côté client.
UMAMI_API_KEY=your_umami_api_key
UMAMI_WEBSITE_ID=c86da298-85af-468e-9451-928fc9cd493a
